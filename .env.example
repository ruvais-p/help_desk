# Copy this file to ".env" and fill in your key.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# The chat model used for answering (any model id supported by OpenRouter).
CHAT_MODEL=openrouter/owl-alpha

# Optional ranking metadata for OpenRouter.
SITE_URL=http://localhost:8000
SITE_NAME=CUSAT Help Desk

# --- Retrieval tuning (sane defaults; change only if needed) ---
# Local embedding model (downloaded once, runs offline, no API cost).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# How many document chunks to feed the model as context.
TOP_K=5
# Minimum cosine similarity (0-1) for a chunk to count as "relevant".
# If the best chunk scores below this, we refuse instead of guessing.
RELEVANCE_THRESHOLD=0.30
# Chunking (in words).
CHUNK_SIZE=220
CHUNK_OVERLAP=40

# --- Internet fallback ---
# When the documents can't answer, search the web and answer from there
# (still grounded + cited; never invented).
ENABLE_WEB_SEARCH=true
# "fallback" = web only when documents are insufficient.
# "always"   = always blend web results with document results.
WEB_MODE=fallback
WEB_RESULTS=6
WEB_MAX_PAGES=4
WEB_RELEVANCE_THRESHOLD=0.28
